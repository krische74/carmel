# Carmel Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# Run 'carmel setup' for interactive first-time configuration.

# === Alpaca Broker (required for trading) ===
# Get paper trading keys at: https://app.alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true  # ALWAYS true for paper trading; change to false ONLY for live

# === Alpaca multi-account (optional) ===
# When broker.accounts is set in config/settings.yaml, define one key pair per account
# using the env var names from YAML (api_key_env / api_secret_env).
# If you leave broker.accounts empty, legacy ALPACA_API_KEY / ALPACA_SECRET_KEY above are used.
# ALPACA_ACCOUNT_MAIN_KEY=
# ALPACA_ACCOUNT_MAIN_SECRET=
# ALPACA_ACCOUNT_IRA_KEY=
# ALPACA_ACCOUNT_IRA_SECRET=

# === FRED Economic Data (optional) ===
# Get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# === Streamlit dashboard (optional) ===
# When dashboard.auth_enabled: true in settings.yaml, set a password here (or use dashboard.auth_password).
DASHBOARD_PASSWORD=

# === REST API (optional) ===
# When set, all /api/* routes require: Authorization: Bearer <token>
# Leave empty for open local access (default for personal use).
API_TOKEN=

# === Logging ===
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# === Webhook notifications ===
# Recommended: keep webhook URL in .env (it's a credential).
# WebhookNotifier auto-detects Discord / Slack / Telegram from the URL host and
# formats JSON accordingly; unknown hosts use a generic {timestamp, level, ...} shape.
#
# Discord:
#   1. Server settings → Integrations → Webhooks → New Webhook
#   2. Copy URL, paste below
# NOTIFICATION__WEBHOOK_URL=https://discord.com/api/webhooks/<channel-id>/<token>
#
# Slack:
#   1. Workspace settings → Apps → Incoming Webhooks → Add New
#   2. Pick channel, copy webhook URL
# NOTIFICATION__WEBHOOK_URL=https://hooks.slack.com/services/<workspace>/<channel>/<token>
#
# Telegram (REQUIRES chat_id):
#   1. Talk to @BotFather, /newbot, copy token
#   2. Send a message to your bot, then visit:
#      https://api.telegram.org/bot<token>/getUpdates → find your "chat":{"id":...}
# NOTIFICATION__WEBHOOK_URL=https://api.telegram.org/bot<token>/sendMessage
# NOTIFICATION__TELEGRAM_CHAT_ID=<your-chat-id>
#
# Generic JSON endpoint (any URL not matching above):
# NOTIFICATION__WEBHOOK_URL=https://your-server.example.com/webhook
NOTIFICATION__ENABLED=false
NOTIFICATION__WEBHOOK_URL=
NOTIFICATION__TELEGRAM_CHAT_ID=

# === Email notifications (optional; SMTP creds also use NOTIFICATION__ prefix) ===
# NOTIFICATION__EMAIL_ENABLED=true
# NOTIFICATION__SMTP_HOST=smtp.gmail.com
# NOTIFICATION__SMTP_PORT=587
# NOTIFICATION__EMAIL_FROM=you@example.com
# NOTIFICATION__EMAIL_TO=alerts@example.com,partner@example.com
# SMTP_USERNAME=you@example.com           ← flat env var (legacy pattern)
# SMTP_PASSWORD=app-specific-password     ← flat env var (legacy pattern)
SMTP_USERNAME=
SMTP_PASSWORD=

# === LLM / Ollama (optional) ===
# Ollama runs locally without auth. Enable in config/settings.yaml (llm.enabled: true).
# Override base URL when running in Docker Compose (set automatically):
# OLLAMA_BASE_URL=http://ollama:11434
# Document RAG uses Ollama /api/embeddings — use an embedding-capable model or llm.model.
# SEC Edgar (optional fundamentals): pip install ".[fundamental]"
# EDGAR_IDENTITY="Your Name you@example.com"  # SEC fair-access User-Agent identity
